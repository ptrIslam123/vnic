# Doxygen configuration for the vnic library.
#
# Build the HTML API docs with one of:
#   doxygen Doxyfile
#   cmake --build build --target vnic-docs      (CMake, see VNIC_BUILD_DOCS)
#
# NOTE: the docs are NOT generated by a default `cmake --build build` / `make`:
#       the `vnic-docs` target must be built explicitly.

PROJECT_NAME           = "vnic"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Userspace NIC emulation library"
OUTPUT_DIRECTORY       = dock/api

# ------------------------------------------------------------------ input
INPUT                  = include \
                         README.md \
                         dock/архитектура.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.md
USE_MDFILE_AS_MAINPAGE = README.md

# ------------------------------------------------------------------ extraction
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ------------------------------------------------------------------ warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# ------------------------------------------------------------------ output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
GENERATE_TESTLIST      = YES
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# ------------------------------------------------------------------ diagrams
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg

# ------------------------------------------------------------------ parsing
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
TAB_SIZE               = 4
